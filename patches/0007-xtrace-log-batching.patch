+// Coalesce renderer->browser Log IPCs. The pipe is thread-local and flushes
+// on size, before a bytecode batch, and from its destructor so process exit
+// does not drop the tail. Members die after ~TraceSender, so the remote is
+// still bound during that flush.
+constexpr size_t kEventBatchCount = 32;
+constexpr size_t kEventBatchBytes = 48 * 1024;
+
+struct TraceSender {
+  mojo::Remote<mojom::blink::XTraceHost> host;
+  std::vector<std::string> lines;
+  size_t bytes = 0;
+  bool flushing = false;
+
+  mojom::blink::XTraceHost* Get() {
+    if (!host.is_bound()) {
+      Platform::Current()->GetBrowserInterfaceBroker()->GetInterface(
+          host.BindNewPipeAndPassReceiver());
+    }
+    return host.get();
+  }
+
+  void Flush() {
+    if (flushing || lines.empty()) {
+      return;
+    }
+    // Enqueue used to flush only when the pipe was already bound, which
+    // never happens on the normal Log path. Bind here or the batch is dropped.
+    if (!host.is_bound()) {
+      if (!Platform::Current()) {
+        return;
+      }
+      Get();
+    }
+    if (!host.is_bound()) {
+      return;
+    }
+    flushing = true;
+    Vector<String> batch;
+    for (std::string& line : lines) {
+      batch.push_back(String::FromUtf8(line));
+    }
+    lines.clear();
+    bytes = 0;
+    host->LogBatch(std::move(batch));
+    flushing = false;
   }
-  return host.get();
+
+  void Enqueue(std::string line) {
+    bytes += line.size();
+    lines.push_back(std::move(line));
+    if (lines.size() >= kEventBatchCount || bytes >= kEventBatchBytes) {
+      Flush();
+    }
+  }
+
+  ~TraceSender() { Flush(); }
+};
+
+TraceSender& EventSender() {
+  thread_local TraceSender sender;
+  return sender;
+}
+
+mojom::blink::XTraceHost* GetXTraceHost() {
+  return EventSender().Get();
+}
+
+void FlushPendingEvents() {
+  EventSender().Flush();
 }
 
