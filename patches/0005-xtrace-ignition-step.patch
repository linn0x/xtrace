+}
+
+bool OpcodeAllowed(unsigned id) {
+  std::call_once(g_bits_once, BuildOpcodeBits);
+  if (id >= 256) return false;
+  uint64_t bit = uint64_t{1} << (id & 63);
+  return (g_allow[id >> 6] & bit) && !(g_deny[id >> 6] & bit);
+}
+
+int EscapeJson(const char* in, char* out, int cap) {
+  int n = 0;
+  auto put = [&](char c) {
+    if (n + 1 >= cap) return false;
+    out[n++] = c;
+    return true;
+  };
+  if (!put('"')) return -1;
+  for (const unsigned char* p = reinterpret_cast<const unsigned char*>(in); *p; ++p) {
+    if (*p == '"' || *p == '\\') {
+      if (!put('\\') || !put(static_cast<char>(*p))) return -1;
+    } else if (*p < 0x20) {
+      if (n + 6 >= cap) return -1;
+      n += std::snprintf(out + n, cap - n, "\\u%04x", *p);
+    } else if (!put(static_cast<char>(*p))) {
+      return -1;
+    }
+  }
+  if (!put('"')) return -1;
+  out[n] = '\0';
+  return n;
+}
+
+bool FillPrefix(Isolate* isolate, Handle<BytecodeArray> bytecode_array) {
+  g_prefix.key = 0;
+  g_prefix.len = 0;
+  g_prefix.values = true;
+  g_prefix.summary = false;
+  const char* mode = v8_flags.xtrace_bytecode_values;
+  if (mode && std::strcmp(mode, "args-only") == 0) g_prefix.values = false;
+  if (mode && std::strcmp(mode, "summary") == 0) g_prefix.summary = true;
+
+  JavaScriptStackFrameIterator frames(isolate);
+  if (frames.done() || !frames.frame()->is_interpreted()) return false;
+  UnoptimizedJSFrame* frame = UnoptimizedJSFrame::cast(frames.frame());
+  Handle<JSFunction> function(frame->function(), isolate);
+  Handle<SharedFunctionInfo> shared(function->shared(), isolate);
+  if (!shared->all_optimization_disabled()) {
+    shared->DisableOptimization(isolate, BailoutReason::kNeverOptimize);
+  }
+  int literal_id = shared->function_literal_id(kRelaxedLoad);
+  int script_id = 0;
+  Tagged<Object> script_obj = shared->script();
+  if (IsScript(script_obj)) script_id = Cast<Script>(script_obj)->id();
+  std::string url;
+  std::string function_name =
+      Handle<String>(shared->Name(), isolate)->ToStdString();
+  if (IsScript(script_obj)) {
+    Tagged<Object> label = Cast<Script>(script_obj)->GetNameOrSourceURL();
+    if (IsString(label)) {
+      url = Handle<String>(Cast<String>(label), isolate)->ToStdString();
+    }
+  }
+  if (!Contains(url.c_str(), v8_flags.xtrace_bytecode_scripts) ||
+      !Contains(function_name.c_str(), v8_flags.xtrace_bytecode_functions)) {
+    return false;
+  }
+  const char* fname = function_name.c_str();
+
+  char url_json[160];
+  char name_json[96];
+  if (EscapeJson(url.c_str(), url_json, sizeof(url_json)) < 0) {
+    std::snprintf(url_json, sizeof(url_json), "\"\"");
+  }
+  if (EscapeJson(fname, name_json, sizeof(name_json)) < 0) {
+    std::snprintf(name_json, sizeof(name_json), "\"\"");
+  }
+  const char* capture = g_prefix.summary ? "summary"
+                         : g_prefix.values ? "full"
+                                           : "args-only";
+  int n = std::snprintf(
+      g_prefix.text, sizeof(g_prefix.text),
+      "[{\"kind\":\"vm_step\",\"pre_state\":true,\"capture_values\":\"%s\","
+      "\"value_truncated\":false,\"script_id\":%d,\"script_url\":%s,"
+      "\"function_name\":%s,\"function_literal_id\":%d,",
+      capture, script_id, url_json, name_json, literal_id);
+  if (n <= 0 || n >= static_cast<int>(sizeof(g_prefix.text))) return false;
+  g_prefix.len = n;
+  g_prefix.key = bytecode_array->ptr();
+  return true;
+}
+
+void XTraceFlushBytecodeBatchInternal(Isolate* isolate) {
+  if (g_flushing || !isolate || !isolate->event_logger()) return;
+  if (g_len == 0 && g_dropped == 0) return;
+  g_flushing = true;
+  std::string msg;
+  msg.reserve(static_cast<size_t>(g_len) + 96);
+  msg.append("xtrace:bytecode-batch:\n");
+  if (g_dropped) {
+    char drop[96];
+    int n = std::snprintf(drop, sizeof(drop),
+                          "Ignition.drop\t[{\"kind\":\"vm_step_drop\",\"dropped\":%u}]\n",
+                          g_dropped);
+    if (n > 0) msg.append(drop, static_cast<size_t>(n));
+    g_dropped = 0;
+  }
+  if (g_len > 0) msg.append(g_batch, static_cast<size_t>(g_len));
+  g_len = 0;
+  g_records = 0;
+  isolate->event_logger()(msg.c_str(), v8::LogEventStatus::kLog);
+  g_flushing = false;
+}
+
+bool AppendRecord(Isolate* isolate, const char* rec, int n) {
+  if (n <= 0) return false;
+  if (g_len + n >= static_cast<int>(kBatchBytes)) {
+    XTraceFlushBytecodeBatchInternal(isolate);
+  }
+  if (g_len + n >= static_cast<int>(kBatchBytes)) {
+    g_dropped++;
+    return false;
+  }
+  std::memcpy(g_batch + g_len, rec, static_cast<size_t>(n));
+  g_len += n;
+  g_records++;
+  if (g_records >= kBatchRecords) XTraceFlushBytecodeBatchInternal(isolate);
+  return true;
+}
+
+const char* ScaleName(int scale) {
+  if (scale == 2) return "Double";
+  if (scale == 4) return "Quadruple";
+  return "Single";
+}
+
+}  // namespace
+
+void XTraceFlushBytecodeBatch() {
+  Isolate* isolate = Isolate::Current();
+  if (isolate == nullptr) return;
+  XTraceFlushBytecodeBatchInternal(isolate);
+}
+
+RUNTIME_FUNCTION(Runtime_XTraceSelectDispatchTable) {
+  HandleScope scope(isolate);
+  DCHECK_EQ(1, args.length());
+  if (!IsBytecodeArray(args[0])) return Smi::FromInt(0);
+  if (g_in_step) return Smi::FromInt(0);
+  XTraceFlushBytecodeBatchInternal(isolate);
+  Handle<BytecodeArray> bytecode_array = CheckedCast<BytecodeArray>(args.at(0));
+  if (!FillPrefix(isolate, bytecode_array)) return Smi::FromInt(0);
+  return Smi::FromInt(1);
+}
+
+RUNTIME_FUNCTION(Runtime_XTraceBytecodeStep) {
+  DCHECK_EQ(3, args.length());
+  if (g_in_step || g_flushing) return ReadOnlyRoots(isolate).undefined_value();
+  if (!IsBytecodeArray(args[0])) return ReadOnlyRoots(isolate).undefined_value();
+  Handle<BytecodeArray> bytecode_array = CheckedCast<BytecodeArray>(args.at(0));
+  int raw_offset = args.smi_value_at(1);
+  int offset = raw_offset - (BytecodeArray::kHeaderSize - kHeapObjectTag);
+  int length = bytecode_array->length();
+  if (offset < 0 || offset >= length) return ReadOnlyRoots(isolate).undefined_value();
+  uint8_t* bytes =
+      reinterpret_cast<uint8_t*>(bytecode_array->GetFirstBytecodeAddress());
+  unsigned opcode = bytes[offset];
+  if (opcode == static_cast<unsigned>(interpreter::Bytecode::kWide) ||
+      opcode == static_cast<unsigned>(interpreter::Bytecode::kExtraWide)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  if (!OpcodeAllowed(opcode)) return ReadOnlyRoots(isolate).undefined_value();
+
+  uint32_t budget = v8_flags.xtrace_bytecode_budget;
+  if (budget && g_emitted >= budget) {
+    g_dropped++;
+    // Flush a pending step batch immediately, then coalesce later drops.
+    if (!g_flushing &&
+        (g_len > 0 || g_dropped >= static_cast<uint32_t>(kBatchRecords))) {
+      XTraceFlushBytecodeBatchInternal(isolate);
+    }
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  uint32_t sample = v8_flags.xtrace_bytecode_sample ? v8_flags.xtrace_bytecode_sample : 1;
+  uint32_t ticket = g_sample.fetch_add(1, std::memory_order_relaxed);
+  if (sample > 1 && (ticket % sample) != 0) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  g_in_step = true;
+  if (bytecode_array->ptr() != g_prefix.key) {
+    HandleScope scope(isolate);
+    FillPrefix(isolate, bytecode_array);
+  }
+  if (bytecode_array->ptr() != g_prefix.key || g_prefix.len <= 0) {
+    g_dropped++;
+    g_in_step = false;
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  int scale = 1;
+  if (offset > 0 && bytes[offset - 1] == static_cast<uint8_t>(interpreter::Bytecode::kWide)) {
+    scale = 2;
+  } else if (offset > 0 &&
+             bytes[offset - 1] == static_cast<uint8_t>(interpreter::Bytecode::kExtraWide)) {
+    scale = 4;
+  }
+  auto bc = static_cast<interpreter::Bytecode>(opcode);
+  const char* opname = interpreter::Bytecodes::ToString(bc);
+
+  char rec[1024];
+  int used = 0;
+  if (g_prefix.len < static_cast<int>(sizeof(rec))) {
+    std::memcpy(rec, g_prefix.text, static_cast<size_t>(g_prefix.len));
+    used = g_prefix.len;
+  }
+  int room = static_cast<int>(sizeof(rec)) - used;
+  int n = std::snprintf(rec + used, room,
+                        "\"bytecode_offset\":%d,\"opcode\":\"%s\","
+                        "\"operand_scale\":\"%s\",\"operands\":[",
+                        offset, opname, ScaleName(scale));
+  if (n < 0 || n >= room) {
+    g_in_step = false;
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  used += n;
+  if (bc == interpreter::Bytecode::kLdaZero) {
+    n = std::snprintf(rec + used, sizeof(rec) - used,
+                      "{\"index\":0,\"type\":\"Imm\",\"value\":0}");
+    if (n > 0 && used + n < static_cast<int>(sizeof(rec))) used += n;
+  } else if (bc == interpreter::Bytecode::kLdaSmi && offset + scale < length) {
+    int32_t imm = 0;
+    std::memcpy(&imm, bytes + offset + 1, static_cast<size_t>(scale == 4 ? 4 : scale));
+    if (scale == 1) imm = static_cast<int8_t>(imm);
+    if (scale == 2) imm = static_cast<int16_t>(imm);
+    n = std::snprintf(rec + used, sizeof(rec) - used,
+                      "{\"index\":0,\"type\":\"Imm\",\"value\":%d}", imm);
+    if (n > 0 && used + n < static_cast<int>(sizeof(rec))) used += n;
+  }
+  n = std::snprintf(rec + used, sizeof(rec) - used, "]");
+  if (n > 0 && used + n < static_cast<int>(sizeof(rec))) used += n;
+
+  n = 0;
+  if (g_prefix.values) {
+    Tagged<Object> acc = args[2];
+    if (IsSmi(acc)) {
+      n = std::snprintf(rec + used, sizeof(rec) - used,
+                        ",\"accumulator_type\":\"smi\",\"accumulator\":%d",
+                        Smi::ToInt(Cast<Smi>(acc)));
+    } else if (IsNumber(acc)) {
+      n = std::snprintf(rec + used, sizeof(rec) - used,
+                        ",\"accumulator_type\":\"number\",\"accumulator\":%.17g",
+                        Object::NumberValue(acc));
+    } else if (IsString(acc)) {
+      n = std::snprintf(rec + used, sizeof(rec) - used,
+                        ",\"accumulator_type\":\"string\",\"accumulator_length\":%u",
+                        Cast<String>(acc)->length());
+    }
+    if (n > 0 && used + n < static_cast<int>(sizeof(rec))) used += n;
+  }
+  n = std::snprintf(rec + used, sizeof(rec) - used, "}]\n");
+  if (n > 0 && used + n < static_cast<int>(sizeof(rec))) used += n;
+  g_emitted++;
+  AppendRecord(isolate, rec, used);
+  g_in_step = false;
+  return ReadOnlyRoots(isolate).undefined_value();
+}
 }  // namespace internal
 }  // namespace v8
