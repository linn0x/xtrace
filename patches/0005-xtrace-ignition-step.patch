+std::string_view NextFilterToken(std::string_view* rest) {
+  if (rest->empty()) return {};
+  size_t comma = rest->find(',');
+  std::string_view token = rest->substr(
+      0, comma == std::string_view::npos ? rest->size() : comma);
+  if (comma == std::string_view::npos) {
+    *rest = {};
+  } else {
+    rest->remove_prefix(comma + 1);
+  }
+  while (!token.empty() && (token.front() == ' ' || token.front() == '\t')) {
+    token.remove_prefix(1);
+  }
+  while (!token.empty() && (token.back() == ' ' || token.back() == '\t')) {
+    token.remove_suffix(1);
+  }
+  return token;
+}
+
+bool SubstringListMatches(const char* list, std::string_view text) {
+  if (list == nullptr || list[0] == '\0') return true;
+  std::string_view rest(list);
+  bool saw_token = false;
+  while (!rest.empty()) {
+    std::string_view token = NextFilterToken(&rest);
+    if (token.empty()) continue;
+    saw_token = true;
+    if (text.find(token) != std::string_view::npos) return true;
+  }
+  return !saw_token;
+}
+
+bool ExactListContains(const char* list, std::string_view text) {
+  if (list == nullptr || list[0] == '\0') return false;
+  std::string_view rest(list);
+  while (!rest.empty()) {
+    std::string_view token = NextFilterToken(&rest);
+    if (!token.empty() && token == text) return true;
+  }
+  return false;
+}
