+void InterpreterAssembler::EmitXTraceDispatchStub() {
+  // One runtime step, then tail-call the clean handler. The traced
+  // dispatch table stays in the dispatch-table parameter so the next
+  // bytecode re-enters this stub. Inlined short Stars are not steps.
+  TNode<BytecodeArray> bytecode_array = BytecodeArrayTaggedPointer();
+  TNode<IntPtrT> offset = BytecodeOffset();
+  TNode<Object> accumulator = GetAccumulatorUnchecked();
+  CallRuntime(Runtime::kXTraceBytecodeStep, GetContext(), bytecode_array,
+              SmiTag(offset), accumulator);
+  bytecode_array = BytecodeArrayTaggedPointer();
+  offset = BytecodeOffset();
+  accumulator = GetAccumulatorUnchecked();
+  TNode<ExternalReference> clean = ExternalConstant(
+      ExternalReference::interpreter_dispatch_table_address(isolate()));
+  TNode<WordT> bytecode = LoadBytecode(offset);
+  TNode<RawPtrT> target =
+      Load<RawPtrT>(clean, TimesSystemPointerSize(bytecode));
+  TailCallBytecodeDispatch(InterpreterDispatchDescriptor{}, target,
+                           accumulator, offset, bytecode_array,
+                           DispatchTablePointer());
+}
+
 void InterpreterAssembler::TraceBytecode(Runtime::FunctionId function_id) {
   CallRuntime(function_id, GetContext(), BytecodeArrayTaggedPointer(),
               SmiTag(BytecodeOffset()), GetAccumulatorUnchecked());
