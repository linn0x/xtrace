+void AppendCapturedValue(std::string* out, Handle<Object> value, const char* mode,
+                         TruncState* trunc, const char* type_key,
+                         const char* value_key, const char* length_key) {
+  Tagged<Object> raw = *value;
+  out->append(",\"");
+  out->append(type_key);
+  out->append("\":");
+  AppendJsonString(out, ValueTypeName(raw));
+  if (IsString(raw)) {
+    Handle<String> string = Cast<String>(value);
+    if (std::strcmp(mode, "summary") == 0) {
+      out->append(",\"");
+      out->append(length_key);
+      out->append("\":");
+      out->append(std::to_string(string->length()));
+      return;
+    }
+    std::string text = string->ToStdString();
+    unsigned max_chars = BytecodeMaxChars();
+    if (text.size() > max_chars) {
+      std::string preview = text.substr(0, std::min<size_t>(text.size(), 64));
+      NoteTruncation(trunc, text.size(), preview, Fnv1a64(text));
+      text = std::move(preview);
+    }
+    out->append(",\"");
+    out->append(value_key);
+    out->append("\":");
+    AppendJsonString(out, text);
+    return;
+  }
+  out->append(",\"");
+  out->append(value_key);
+  out->append("\":");
+  out->append(JsonLiteral(value));
+}
