+void NoteTruncation(TruncState* trunc, size_t original_size, std::string preview,
+                    std::string hash) {
+  trunc->count++;
+  if (!trunc->any || original_size > trunc->original_size) {
+    trunc->original_size = original_size;
+    trunc->preview = std::move(preview);
+    trunc->hash = std::move(hash);
+  }
+  trunc->any = true;
+}
