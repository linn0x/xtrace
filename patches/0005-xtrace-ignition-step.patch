+const char* ValueTypeName(Tagged<Object> value) {
+  if (IsSmi(value)) return "smi";
+  if (IsHeapNumber(value)) return "number";
+  if (IsString(value)) return "string";
+  if (IsTrue(value) || IsFalse(value)) return "boolean";
+  if (IsNull(value)) return "null";
+  if (IsUndefined(value)) return "undefined";
+  if (IsBigInt(value)) return "bigint";
+  if (IsSymbol(value)) return "symbol";
+  if (IsJSFunction(value)) return "function";
+  if (IsJSArray(value)) return "array";
+  if (IsJSReceiver(value)) return "object";
+  return "value";
+}
+
+std::string JsonLiteral(Handle<Object> value) {
+  Tagged<Object> raw = *value;
+  if (IsSmi(raw)) return std::to_string(Smi::ToInt(raw));
+  if (IsHeapNumber(raw)) {
+    double number = Object::NumberValue(raw);
+    if (!std::isfinite(number)) {
+      if (std::isnan(number)) return "\"NaN\"";
+      return number > 0 ? "\"Infinity\"" : "\"-Infinity\"";
+    }
+    char buf[kDoubleToStringMinBufferSize];
+    std::string_view text = DoubleToStringView(
+        number, base::Vector<char>(buf, static_cast<int>(sizeof(buf))));
+    return std::string(text);
+  }
+  if (IsTrue(raw)) return "true";
+  if (IsFalse(raw)) return "false";
+  if (IsNull(raw)) return "null";
+  if (IsUndefined(raw)) return "\"undefined\"";
+  return "null";
+}
