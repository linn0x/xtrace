+// Opt-in Ignition step. Handler entry (and inlined short Star) calls this only
+// when v8_flags.xtrace_bytecode is set. Values are the pre-instruction state.
+RUNTIME_FUNCTION(Runtime_XTraceBytecodeStep) {
+  if (!v8_flags.xtrace_bytecode || isolate->serializer_enabled() ||
+      isolate->event_logger() == nullptr) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  unsigned budget = v8_flags.xtrace_bytecode_budget;
+  if (budget > 0 &&
+      g_xtrace_bytecode_emitted.load(std::memory_order_relaxed) >= budget) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  if (g_xtrace_bytecode_in_hook) return XTraceBytecodeUndefined(isolate);
+  XTraceBytecodeReentry reentry(&g_xtrace_bytecode_in_hook);
+
+  HandleScope scope(isolate);
+  if (args.length() != 3 || !IsBytecodeArray(args[0])) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  JavaScriptStackFrameIterator frames(isolate);
+  if (frames.done()) return XTraceBytecodeUndefined(isolate);
+  JavaScriptFrame* js_frame = frames.frame();
+  if (!js_frame->is_interpreted()) return XTraceBytecodeUndefined(isolate);
+  UnoptimizedJSFrame* frame = UnoptimizedJSFrame::cast(js_frame);
+
+  Handle<JSFunction> function(frame->function(), isolate);
+  Handle<SharedFunctionInfo> shared(function->shared(), isolate);
+  int literal_id = shared->function_literal_id(kRelaxedLoad);
+  int script_id = 0;
+  Tagged<Object> script_obj = shared->script();
+  if (IsScript(script_obj)) script_id = Cast<Script>(script_obj)->id();
+
+  std::string url;
+  std::string function_name;
+  IdentityCache& cached = g_xtrace_bytecode_identity;
+  if (cached.valid && cached.isolate == isolate &&
+      cached.script_id == script_id && cached.literal_id == literal_id) {
+    if (!cached.matches) return XTraceBytecodeUndefined(isolate);
+    url = cached.url;
+    function_name = cached.name;
+  } else {
+    function_name = Handle<String>(shared->Name(), isolate)->ToStdString();
+    if (IsScript(script_obj)) {
+      Handle<Script> script(Cast<Script>(script_obj), isolate);
+      Tagged<Object> label = script->GetNameOrSourceURL();
+      if (IsString(label)) {
+        url = Handle<String>(Cast<String>(label), isolate)->ToStdString();
+      }
+    }
+    bool matches =
+        SubstringListMatches(v8_flags.xtrace_bytecode_scripts, url) &&
+        SubstringListMatches(v8_flags.xtrace_bytecode_functions, function_name);
+    cached = IdentityCache{true,     isolate, script_id, literal_id,
+                           matches, url,     function_name};
+    if (!matches) return XTraceBytecodeUndefined(isolate);
+  }
+
+  if (!shared->all_optimization_disabled()) {
+    shared->DisableOptimization(isolate, BailoutReason::kNeverOptimize);
+  }
+
+  // Identity and DisableOptimization can allocate. Re-read the frame before
+  // touching interpreter registers so a GC cannot leave the pointer stale.
+  JavaScriptStackFrameIterator live_frames(isolate);
+  if (live_frames.done() || !live_frames.frame()->is_interpreted()) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  frame = UnoptimizedJSFrame::cast(live_frames.frame());
+
+  Handle<BytecodeArray> bytecode_array =
+      CheckedCast<BytecodeArray>(args.at(0));
+  int raw_offset = args.smi_value_at(1);
+  int offset = raw_offset - BytecodeArray::kHeaderSize + kHeapObjectTag;
+  if (offset < 0) return XTraceBytecodeUndefined(isolate);
+  interpreter::BytecodeArrayIterator iterator(bytecode_array, offset);
+  if (iterator.done() || iterator.current_offset() != offset) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  interpreter::Bytecode bytecode = iterator.current_bytecode();
+  if (interpreter::Bytecodes::IsPrefixScalingBytecode(bytecode)) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+  const char* opcode = interpreter::Bytecodes::ToString(bytecode);
+  const char* opcode_allow = v8_flags.xtrace_bytecode_opcodes;
+  const char* opcode_deny = v8_flags.xtrace_bytecode_opcode_deny;
+  if (ExactListContains(opcode_deny, opcode) ||
+      (opcode_allow != nullptr && opcode_allow[0] != '\0' &&
+       !ExactListContains(opcode_allow, opcode))) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+
+  unsigned sample = v8_flags.xtrace_bytecode_sample;
+  if (sample < 1) sample = 1;
+  uint64_t match_index =
+      g_xtrace_bytecode_matched.fetch_add(1, std::memory_order_relaxed);
+  if (sample > 1 && (match_index % sample) != 0) {
+    return XTraceBytecodeUndefined(isolate);
+  }
+
+  const char* mode = BytecodeValueMode();
+  bool capture_values = std::strcmp(mode, "args-only") != 0;
+  TruncState trunc;
+  Handle<Object> accumulator = args.at(2);
+  std::vector<CapturedReg> captured;
+  int register_total = 0;
+  std::string operands = "[";
+  bool first_operand = true;
+  int operand_count = interpreter::Bytecodes::NumberOfOperands(bytecode);
+  for (int i = 0; i < operand_count; ++i) {
+    interpreter::OperandType type =
+        interpreter::Bytecodes::GetOperandType(bytecode, i);
+    if (!first_operand) operands.push_back(',');
+    first_operand = false;
+    operands.append("{\"index\":");
+    operands.append(std::to_string(i));
+    operands.append(",\"type\":");
+    AppendJsonString(&operands, OperandTypeName(type));
+    if (interpreter::Bytecodes::IsRegisterOperandType(type)) {
+      if (type == interpreter::OperandType::kRegList ||
+          type == interpreter::OperandType::kRegOutList) {
+        interpreter::RegisterList list = iterator.GetRegisterListOperand(i);
+        int count = list.register_count();
+        if (count > 0) {
+          operands.append(",\"name\":");
+          AppendJsonString(&operands, list.first_register().ToString());
+          operands.append(",\"count\":");
+          operands.append(std::to_string(count));
+          if (capture_values) {
+            for (int reg_index = 0; reg_index < count; ++reg_index) {
+              ConsiderRegister(isolate, frame, list[reg_index], &captured,
+                               &register_total);
+            }
+          }
+        }
+      } else {
+        interpreter::Register first = iterator.GetRegisterOperand(i);
+        uint32_t represented =
+            interpreter::Bytecodes::GetNumberOfRegistersRepresentedBy(type);
+        operands.append(",\"name\":");
+        AppendJsonString(&operands, first.ToString());
+        if (capture_values) {
+          for (uint32_t reg_index = 0; reg_index < represented; ++reg_index) {
+            ConsiderRegister(
+                isolate, frame,
+                interpreter::Register(first.index() + static_cast<int>(reg_index)),
+                &captured, &register_total);
+          }
+        }
+      }
+    } else if (type == interpreter::OperandType::kImm) {
+      operands.append(",\"value\":");
+      operands.append(std::to_string(iterator.GetImmediateOperand(i)));
+    } else if (type == interpreter::OperandType::kConstantPoolIndex) {
+      operands.append(",\"value\":");
+      operands.append(
+          std::to_string(iterator.GetConstantPoolIndexOperand(i)));
+      if (capture_values) {
+        Handle<Object> constant = iterator.GetConstantForOperand(i, isolate);
+        AppendCapturedValue(&operands, constant, mode, &trunc, "constant_type",
+                            "constant", "constant_length");
+      }
+    } else if (type != interpreter::OperandType::kNone) {
+      operands.append(",\"value\":");
+      operands.append(std::to_string(UnsignedOperand(iterator, type, i)));
+    }
+    operands.push_back('}');
+  }
+  if (interpreter::Bytecodes::IsShortStar(bytecode)) {
+    interpreter::Register reg = interpreter::Register::FromShortStar(bytecode);
+    if (!first_operand) operands.push_back(',');
+    operands.append("{\"index\":0,\"type\":\"RegOut\",\"name\":");
+    AppendJsonString(&operands, reg.ToString());
+    operands.push_back('}');
+    if (capture_values) {
+      ConsiderRegister(isolate, frame, reg, &captured, &register_total);
+    }
+  }
+  operands.push_back(']');
+  if (register_total > static_cast<int>(captured.size())) {
+    std::string preview;
+    for (const CapturedReg& reg : captured) {
+      if (!preview.empty()) preview.push_back(',');
+      preview.append(reg.name);
+      if (preview.size() >= 64) break;
+    }
+    NoteTruncation(&trunc, static_cast<size_t>(register_total), preview,
+                   Fnv1a64(std::to_string(register_total)));
+  }
+
+  std::string args_json = "[{\"kind\":\"vm_step\",\"pre_state\":true,\"capture_values\":";
+  AppendJsonString(&args_json, mode);
+  args_json.append(",\"script_id\":");
+  args_json.append(std::to_string(script_id));
+  args_json.append(",\"script_url\":");
+  AppendJsonString(&args_json, url);
+  args_json.append(",\"function_name\":");
+  AppendJsonString(&args_json, function_name);
+  args_json.append(",\"function_literal_id\":");
+  args_json.append(std::to_string(literal_id));
+  args_json.append(",\"bytecode_offset\":");
+  args_json.append(std::to_string(offset));
+  args_json.append(",\"opcode\":");
+  AppendJsonString(&args_json, opcode);
+  args_json.append(",\"operand_scale\":");
+  AppendJsonString(&args_json, OperandScaleName(iterator.current_operand_scale()));
+  args_json.append(",\"operands\":");
+  args_json.append(operands);
+  if (capture_values) {
+    AppendCapturedValue(&args_json, accumulator, mode, &trunc, "accumulator_type",
+                        "accumulator", "accumulator_length");
+    if (!captured.empty()) {
+      args_json.append(",\"registers\":[");
+      for (size_t i = 0; i < captured.size(); ++i) {
+        if (i != 0) args_json.push_back(',');
+        args_json.append("{\"name\":");
+        AppendJsonString(&args_json, captured[i].name);
+        AppendCapturedValue(&args_json, captured[i].value, mode, &trunc, "type",
+                            "value", "value_length");
+        args_json.push_back('}');
+      }
+      args_json.push_back(']');
+    }
+  }
+  args_json.append(",\"value_truncated\":");
+  args_json.append(trunc.any ? "true" : "false");
+  args_json.append("}]");
+
+  if (budget > 0) {
+    uint64_t ticket =
+        g_xtrace_bytecode_emitted.fetch_add(1, std::memory_order_relaxed);
+    if (ticket >= budget) return XTraceBytecodeUndefined(isolate);
+  } else {
+    g_xtrace_bytecode_emitted.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  std::string message = "xtrace:bytecode:Ignition.step\n";
+  message.append(args_json);
+  message.push_back('\n');
+  if (trunc.any) {
+    message.append("{\"original_size\":");
+    message.append(std::to_string(trunc.original_size));
+    message.append(",\"preview\":");
+    AppendJsonString(&message, trunc.preview);
+    message.append(",\"hash\":");
+    AppendJsonString(&message, trunc.hash);
+    if (trunc.count > 1) {
+      message.append(",\"truncated_value_count\":");
+      message.append(std::to_string(trunc.count));
+    }
+    message.push_back('}');
+  }
+  isolate->event_logger()(message.c_str(), v8::LogEventStatus::kLog);
+  return XTraceBytecodeUndefined(isolate);
+}
 }  // namespace internal
 }  // namespace v8
