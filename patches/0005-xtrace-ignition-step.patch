+
+bool ExactToken(const char* list, const char* token) {
+  if (!list || !list[0]) return false;
+  size_t n = std::strlen(token);
+  const char* p = list;
+  while (*p) {
+    while (*p == ',') ++p;
+    const char* start = p;
+    while (*p && *p != ',') ++p;
+    if (static_cast<size_t>(p - start) == n && std::memcmp(start, token, n) == 0) {
+      return true;
+    }
+  }
+  return false;
