+void XTraceLogger::LogEventNoStackWithTruncation(
+    const char* category,
+    const char* phase,
+    const char* api,
+    const String& args_json,
+    const String& truncation_json) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!CategoryEnabled(config, category)) {
+    return;
+  }
+
+  std::string truncation_utf8 =
+      truncation_json.IsNull() ? std::string() : truncation_json.Utf8();
+  const uint64_t seq = NextSequenceNumber();
+  LogEventWithSequence(config, category, phase, api, args_json, seq,
+                       std::string_view(), false, std::string_view(),
+                       std::string_view(), nullptr, truncation_utf8);
+}
