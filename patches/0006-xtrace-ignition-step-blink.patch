+void XTraceLogger::LogBytecodeBatch(const String& payload) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!CategoryEnabled(config, "bytecode")) {
+    return;
+  }
+  std::string text = payload.Utf8();
+  std::string_view rest(text);
+  std::vector<std::string> lines;
+  while (!rest.empty()) {
+    size_t nl = rest.find('\n');
+    std::string_view row = nl == std::string_view::npos ? rest : rest.substr(0, nl);
+    if (nl == std::string_view::npos) {
+      rest = std::string_view();
+    } else {
+      rest.remove_prefix(nl + 1);
+    }
+    if (row.empty()) {
+      continue;
+    }
+    size_t tab = row.find('\t');
+    if (tab == std::string_view::npos || tab == 0 || tab + 1 >= row.size()) {
+      continue;
+    }
+    std::string api(row.substr(0, tab));
+    std::string_view args = row.substr(tab + 1);
+    const uint64_t seq = NextSequenceNumber();
+    LogEventWithSequence(config, "bytecode", "call", api.c_str(),
+                         String::FromUtf8WithLatin1Fallback(args), seq,
+                         std::string_view(), false, std::string_view(),
+                         std::string_view(), nullptr, std::string_view(),
+                         &lines);
+  }
+  if (lines.empty()) {
+    return;
+  }
+  Vector<String> batch;
+  for (const std::string& line : lines) {
+    batch.push_back(String::FromUtf8(line));
+  }
+  GetXTraceHost()->LogBatch(std::move(batch));
+}
